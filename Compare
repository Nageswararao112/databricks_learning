
from pyspark.sql import functions as F

m = F.col("operationMetrics")
for t in ["cdnseg_consolidated_customer", "cdnseg_single_view_customer"]:
    print(t)
    display(
        spark.sql(f"DESCRIBE HISTORY ops_plab_catalog.mdm_hub.{t}")
             .filter("userName = 'bhatrna@mfcgd.com' AND operation = 'MERGE'")
             .select("version", "timestamp",
                     m["numSourceRows"].alias("source_rows"),
                     m["numTargetRowsInserted"].alias("inserted"),
                     m["numTargetRowsUpdated"].alias("updated"),
                     m["numTargetRowsDeleted"].alias("deleted"))
             .orderBy("version")
    )


SELECT
  (SELECT count(*) FROM ops_plab_catalog.mdm_hub.cdnseg_consolidated_customer) AS consolidated_total,
  (SELECT count(*) FROM ops_plab_catalog.mdm_hub.cdnseg_single_view_customer)  AS single_view_total,
  (SELECT count(*) FROM ops_plab_catalog.mdm_hub.cdnseg_consolidated_customer c
     LEFT ANTI JOIN ops_plab_catalog.mdm_hub.cdnseg_single_view_customer s
     ON c.mdm_customer_id = s.mdm_customer_id)                                  AS only_in_consolidated;


DELETE FROM ops_plab_catalog.mdm_hub.cdnseg_consolidated_customer
WHERE mdm_customer_id IN (SELECT mdm_customer_id FROM only_in_cc);


CREATE OR REPLACE TEMP VIEW only_in_cc AS
SELECT c.mdm_customer_id
FROM ops_plab_catalog.mdm_hub.cdnseg_consolidated_customer c
LEFT ANTI JOIN ops_plab_catalog.mdm_hub.cdnseg_single_view_customer s
ON c.mdm_customer_id = s.mdm_customer_id;

CREATE OR REPLACE TEMP VIEW sv_deleted_791 AS
SELECT DISTINCT mdm_customer_id
FROM table_changes('ops_plab_catalog.mdm_hub.cdnseg_single_view_customer', 791, 791)
WHERE _change_type = 'delete';

SELECT count(*) AS overlap
FROM only_in_cc JOIN sv_deleted_791 USING (mdm_customer_id);



